{
  "name": "blaster-master",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "gate": "bash scripts/gate.sh",
    "gate:compile": "GATE_TESTS=0 bash scripts/gate.sh",
    "board": "bash scripts/board.sh",
    "publish": "bash scripts/publish.sh",
    "format": "eslint . --fix",
    "deploy:sync": "powershell -NoProfile -File ./deploy-sync.ps1"
  },
  "dependencies": {
    "phaser": "^3.87.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.21.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vite": "^6.2.0",
    "vitest": "^3.0.8",
    "zod": "^3.24.2"
  }
}
